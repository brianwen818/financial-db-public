# FinMind API credentials. Copy to .env and fill in.
# Register at https://finmindtrade.com/ to obtain a token.
FINMIND_TOKEN=your_token_here

# Hourly API request cap for your subscription tier.
# Free=600 Backer=1600 Sponsor=6000 SponsorPro=20000
FINMIND_API_HOUR_LIMIT=6000

# Tier name, informational only.
FINMIND_SUBSCRIPTION_PLAN="Sponsor"

# Optional: override the data root. Defaults to the value in config/paths.yml.
# FINMIND_DB_ROOT=<repo>\db\finmind
